# Hermes profile environment — read by MadeEA OS for Jarvis's voice.
#
# Real path on this machine (NOT the ~/.hermes/profiles/main/.env the guide
# gives — HERMES_HOME here is %LOCALAPPDATA%\hermes):
#   C:\Users\USER\AppData\Local\hermes\profiles\main\.env
#
# The live file lives outside this repo and must stay there. This is a
# template only — never copy the live file over it.

ELEVENLABS_API_KEY=your_key_here

# The pack's built-in default (21m00Tcm4TlvDq8ikWAM, "Rachel") is a LIBRARY
# voice, and a free plan cannot synthesise with those through the API:
#   402 — "Free users cannot use library voices via the API."
# Use a premade voice from your own account instead. Daniel is British and
# suits the butler voice the guide describes.
AGENTIC_OS_TTS_VOICE=onwK4e9ZLuTAKqWW03F9
