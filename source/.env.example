# MadeEA OS — environment
#
#   cp .env.example .env.local     (.env.local is gitignored; this file is not)
#
# Every variable the code reads is listed here — 82 of them, found by grepping
# process.env across src/ and scripts/. Only two are REQUIRED. Everything else
# switches on one feature, and leaving it unset disables that feature and
# nothing more.
#
# Startup validation (src/instrumentation.ts) checks the required ones when the
# server boots and refuses to start with a message naming what is missing,
# rather than failing later on a request nobody is watching.
#
# ── Do not set these ────────────────────────────────────────────────────────
# APPDATA, HOME, PATH, SHELL, USER come from the operating system. The code
# reads them; setting them here would be wrong.


# ════════════════════════════════════════════════════════════════════════════
# REQUIRED — the app will not start without these
# ════════════════════════════════════════════════════════════════════════════

# Supabase project. Without them nobody can sign in, and sign-in gates the whole
# dashboard, so the app is unusable. Project Settings -> API in Supabase.
# The anon key is public by design — it identifies the project and grants
# nothing. Row Level Security is what protects data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...


# ════════════════════════════════════════════════════════════════════════════
# REQUIRED ON WINDOWS
# ════════════════════════════════════════════════════════════════════════════

# The binary resolver falls back to which("codex"), which does not find the
# Windows install even with codex.exe on PATH. Without this every Codex engine
# returns 500 "codex is not installed or not configured" — which reads like an
# auth problem and is not one.
AGENTIC_OS_CODEX_BIN=C:\Users\you\AppData\Local\Programs\OpenAI\Codex\bin\codex.exe


# ════════════════════════════════════════════════════════════════════════════
# OmniRoute gateway — powers chat, the Claude tab and the agent room
# ════════════════════════════════════════════════════════════════════════════

# Defaults to http://127.0.0.1:20128. Use 127.0.0.1 rather than localhost: over
# IPv6 the gateway answers 200 with an empty completion instead of refusing, so
# callers see success and no content. Point at an https address to use a gateway
# that is not on this machine.
OMNIROUTE_BASE_URL=http://127.0.0.1:20128
OMNIROUTE_MODEL=oc/big-pickle
# The free providers are keyless; the CLIs still require some value.
OMNIROUTE_API_KEY=free-local


# ════════════════════════════════════════════════════════════════════════════
# Model provider keys — each unlocks one feature, all optional
# ════════════════════════════════════════════════════════════════════════════

# Codex "gpt56" engine. Without it Codex uses your `codex login` OAuth session.
OPENAI_API_KEY=
# Model for that engine. gpt-5.6-{sol|terra|luna} work on an API key and a
# ChatGPT account. Bare gpt-5.6 does not exist.
CODEX_NATIVE_MODEL=gpt-5.6-sol

OPENROUTER_API_KEY=
GLM_API_KEY=
GLM_BASE_URL=
GLM_CODE_BASE=
GLM_CODE_MODEL=
ZAI_API_KEY=
Z_AI_API_KEY=
NOUS_API_KEY=
SAKANA_API_KEY=
OLLAMA_API_KEY=
OLLAMA_HOST=
ELEVENLABS_API_KEY=
SUNO_API_KEY=
SUNO_API_BASE=
SUNO_CALLBACK_URL=
FIRECRAWL_API_KEY=
HUNTER_API_KEY=
YT_API_KEY=

# Local OpenAI-compatible server (LM Studio, llama.cpp, Ollama's OpenAI shim).
LOCAL_OPENAI_BASE=
LOCAL_OPENAI_MODEL=
LOCAL_MODEL=
LOCAL_MODEL_LABEL=

# Per-feature model overrides.
APOLLO_REALTIME_MODEL=
DEXPRESS_MODEL=
LEADS_MODEL=
RADAR_MODEL=
RADAR_PROVIDER=
OPENCODE_MODEL=


# ════════════════════════════════════════════════════════════════════════════
# Agent CLIs — set only if the resolver cannot find them
# ════════════════════════════════════════════════════════════════════════════
# Each resolves as: this variable, then the config file, then a PATH lookup.
# On Windows that PATH lookup is unreliable (see AGENTIC_OS_CODEX_BIN above), so
# set the ones you actually use.

AGENTIC_OS_CLAUDE_BIN=
AGENTIC_OS_ANT_BIN=
AGENTIC_OS_OPENCLAW_BIN=
AGENTIC_OS_HERMES_BIN=
AGENTIC_OS_KIMI_BIN=
AGENTIC_OS_GROK_BIN=
AGENTIC_OS_ANTIGRAVITY_BIN=
AGENTIC_OS_RUFLO_BIN=
AGENTIC_OS_NLM_MCP_BIN=
AGENTIC_OS_PY_BIN=
AGENTIC_OS_VALIDATOR_PY=
AGENTIC_OS_GMAIL_PY=
AGENTIC_OS_CLAUDEFLOW=
OPENCODE_BIN=
HYPERFRAMES_BIN=
OPENMONTAGE_PYTHON=
VIDEOUSE_RUNNER=


# ════════════════════════════════════════════════════════════════════════════
# Paths — all default to sensible locations under your home directory
# ════════════════════════════════════════════════════════════════════════════

AGENTIC_OS_CONFIG=
AGENTIC_OS_VAULT=
AGENTIC_OS_CLAUDE_SCRATCH=
AGENTIC_OS_CODEX_SCRATCH=
AGENTIC_OS_KIMI_SCRATCH=
AGENTIC_OS_FCC_SCRATCH=
AGENTIC_OS_LOCAL_BUILDS=
AGENTIC_OS_ULTRACODE_RUNS=
AGENTIC_OS_OPENCLAW_LOGS=
AGENTIC_OS_HERMES_LOGS=
HERMES_HOME=
HERMES_PROFILE=


# ════════════════════════════════════════════════════════════════════════════
# Personalisation
# ════════════════════════════════════════════════════════════════════════════

AGENTIC_OS_USER_NAME=
AGENTIC_OS_LOCATION=
AGENTIC_OS_TTS_VOICE=
AGENTIC_OS_YT_CHANNEL=
AGENTIC_OS_CLAUDE_MODEL=
AGENTIC_OS_OPENCLAW_AGENT=
NEXT_PUBLIC_AGENTIC_OS_OWNER=

PAPERCLIP_API=
PAPERCLIP_BASE=
PAPERCLIP_COMPANY=


# ════════════════════════════════════════════════════════════════════════════
# Operations
# ════════════════════════════════════════════════════════════════════════════

# debug | info | warn | error. Default info.
LOG_LEVEL=info

# Port `npm run smoke` starts its throwaway server on. Default 3311.
SMOKE_PORT=3311
