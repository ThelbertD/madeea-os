# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template, which carries no values and is the only record of
# which variables exist. Without this negation `.env*` swallows it and a new
# developer has nothing to copy.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env.local
.env

# ruflo/claude-flow runtime data — never ship or commit (audit #12)
.claude-flow/
member-pack/.claude-flow/

# Local Netlify folder
.netlify

# Rendered OpenMontage output — regenerated on demand, some are tens of MB
/public/openmontage/generated/
